{
  "name": "agent-skill-hub",
  "version": "0.1.0",
  "description": "Standalone Agent template and Skill repository hub for MTL-Code compatible clients.",
  "type": "module",
  "main": "src/server.js",
  "bin": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js",
    "package:win": "pkg . --targets node20-win-x64 --output dist/agent-skill-hub.exe"
  },
  "keywords": [
    "agent",
    "skill",
    "catalog",
    "mtl-code"
  ],
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "express": "^4.18.2"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.19.0"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  }
}
