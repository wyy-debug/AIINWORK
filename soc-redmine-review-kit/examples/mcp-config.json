{
  "mcpServers": {
    "soc-redmine": {
      "type": "stdio",
      "command": "node",
      "args": [
        "D:\\tools\\soc-redmine-mcp\\src\\server.js"
      ],
      "env": {
        "REDMINE_BASE_URL": "http://soc-redmine.wd.com",
        "REDMINE_API_KEY": "<your-redmine-api-key>"
      }
    },
    "ainwork-code-search": {
      "type": "stdio",
      "command": "node",
      "args": [
        "D:\\tools\\ainwork-code-search-mcp\\src\\server.js"
      ],
      "env": {
        "GITNEXUS_PACKAGE": "gitnexus@1.6.3",
        "GITNEXUS_IGNORE_SCRIPTS": "true",
        "GITNEXUS_MCP_TIMEOUT_MS": "60000"
      }
    }
  }
}
