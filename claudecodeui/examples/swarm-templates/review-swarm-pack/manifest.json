{
  "schemaVersion": 1,
  "id": "review-swarm-pack",
  "version": "1.0.0",
  "kind": "swarm-template",
  "topology": {
    "type": "queen",
    "coordinatorRoleId": "queen",
    "edges": [
      { "from": "queen", "to": "security-reviewer", "topic": "review.assignments" },
      { "from": "queen", "to": "test-writer", "topic": "test.assignments" },
      { "from": "security-reviewer", "to": "summarizer", "topic": "review.findings" },
      { "from": "test-writer", "to": "summarizer", "topic": "test.findings" }
    ]
  },
  "roles": [
    {
      "id": "queen",
      "label": "Review Queen",
      "agentTemplateId": "review-coordinator",
      "count": 1,
      "runtime": { "tools": ["Read", "Grep"], "model": "sonnet" },
      "topics": ["review.assignments", "test.assignments"]
    },
    {
      "id": "security-reviewer",
      "label": "Security Reviewer",
      "agentTemplateId": "security-reviewer",
      "count": 1,
      "dependencies": {
        "required": { "skills": ["code-review-security"] }
      },
      "topics": ["review.findings"]
    },
    {
      "id": "test-writer",
      "label": "Test Writer",
      "agentTemplateId": "test-writer",
      "count": 1,
      "topics": ["test.findings"]
    },
    {
      "id": "summarizer",
      "label": "Result Summarizer",
      "agentTemplateId": "summary-writer",
      "count": 1
    }
  ],
  "routing": {
    "topics": [
      { "name": "review.assignments", "subscribers": ["security-reviewer"], "ackPolicy": "at_least_once" },
      { "name": "test.assignments", "subscribers": ["test-writer"], "ackPolicy": "at_least_once" },
      { "name": "review.findings", "subscribers": ["summarizer"], "ackPolicy": "at_least_once" },
      { "name": "test.findings", "subscribers": ["summarizer"], "ackPolicy": "at_least_once" }
    ]
  },
  "bus": {
    "provider": "local-sqlite",
    "ackPolicy": "at_least_once",
    "retryLimit": 2,
    "ttlMs": 600000
  },
  "memory": {
    "enabled": true,
    "promotion": "manual",
    "scopes": ["facts", "decisions", "artifacts", "role-notes"]
  },
  "policies": {
    "maxAgents": 6,
    "maxDepth": 3,
    "tokenBudget": 240000,
    "timeoutMs": 3600000,
    "messageSizeLimit": 32768
  },
  "dependencies": {
    "optional": {
      "mcpServers": ["linear"],
      "modelProfiles": ["sonnet-large"]
    }
  },
  "dialogs": {
    "setup": {
      "title": "Review swarm setup",
      "fields": [
        { "id": "repository", "label": "Repository", "type": "path", "required": true },
        { "id": "risk_focus", "label": "Risk focus", "type": "multiselect", "options": ["auth", "payments", "data", "performance"] }
      ],
      "presets": [
        { "id": "security-first", "label": "Security first", "answers": { "risk_focus": ["auth", "data"] } }
      ],
      "defaultPresetId": "security-first"
    },
    "launch": {
      "title": "Dispatch review swarm",
      "fields": [
        { "id": "objective", "label": "Objective", "type": "textarea", "required": true },
        { "id": "diff_scope", "label": "Diff scope", "type": "text", "defaultValue": "current branch" }
      ],
      "presets": [
        { "id": "pr-review", "label": "PR review", "answers": { "objective": "Review the current pull request for correctness, security, and missing tests.", "diff_scope": "current branch" } }
      ],
      "defaultPresetId": "pr-review"
    },
    "result": {
      "title": "Swarm result",
      "fields": [
        { "id": "export_format", "label": "Export format", "type": "select", "options": ["markdown", "json"], "defaultValue": "markdown" }
      ]
    }
  },
  "examples": [
    {
      "title": "Review auth refactor",
      "transcript": [
        { "role": "user", "content": "Review the auth refactor with security and regression-test coverage." },
        { "role": "assistant", "content": "The queen assigns review and test work, then the summarizer merges findings into a final report." }
      ]
    }
  ],
  "compat": {
    "argusUi": ">=1.31.0",
    "claudeCode": "subagent-runtime"
  }
}
