{
  "schemaVersion": 1,
  "id": "map-reduce-research-swarm",
  "version": "0.1.0-preview",
  "kind": "swarm-template",
  "topology": {
    "type": "map_reduce",
    "coordinatorRoleId": "planner",
    "edges": [
      {
        "from": "planner",
        "to": "researcher",
        "topic": "research.assignments"
      },
      {
        "from": "researcher",
        "to": "synthesizer",
        "topic": "research.findings"
      },
      {
        "from": "synthesizer",
        "to": "planner",
        "topic": "research.summary"
      }
    ]
  },
  "roles": [
    {
      "id": "planner",
      "label": "Research Planner",
      "agentTemplateId": "research-planner",
      "topics": [
        "research.summary"
      ]
    },
    {
      "id": "researcher",
      "label": "Research Mapper",
      "agentTemplateId": "research-mapper",
      "count": 3,
      "topics": [
        "research.assignments"
      ]
    },
    {
      "id": "synthesizer",
      "label": "Research Reducer",
      "agentTemplateId": "research-synthesizer",
      "topics": [
        "research.findings"
      ]
    }
  ],
  "routing": {
    "topics": [
      {
        "name": "research.assignments",
        "subscribers": [
          "researcher"
        ],
        "ackPolicy": "at_least_once"
      },
      {
        "name": "research.findings",
        "subscribers": [
          "synthesizer"
        ],
        "ackPolicy": "at_least_once"
      },
      {
        "name": "research.summary",
        "subscribers": [
          "planner"
        ],
        "ackPolicy": "at_least_once"
      }
    ]
  },
  "bus": {
    "provider": "local-sqlite",
    "ackPolicy": "at_least_once",
    "retryLimit": 3,
    "ttlMs": 300000
  },
  "memory": {
    "enabled": true,
    "promotion": "manual",
    "scopes": [
      "facts",
      "decisions",
      "artifacts",
      "role-notes"
    ]
  },
  "policies": {
    "maxAgents": 8,
    "maxDepth": 4,
    "tokenBudget": 250000,
    "timeoutMs": 3600000,
    "messageSizeLimit": 32768
  },
  "dependencies": {
    "mcpServers": [
      {
        "id": "web-search",
        "required": false
      }
    ],
    "skills": [
      {
        "id": "research",
        "required": false
      }
    ],
    "modelProfiles": [
      {
        "id": "default",
        "required": true
      }
    ]
  },
  "dialogs": {
    "launch": {
      "title": "Launch Research Swarm",
      "fields": [
        {
          "id": "research_question",
          "label": "Research question",
          "type": "textarea",
          "required": true
        },
        {
          "id": "depth",
          "label": "Depth",
          "type": "select",
          "options": [
            {
              "label": "Fast",
              "value": "fast"
            },
            {
              "label": "Balanced",
              "value": "balanced"
            },
            {
              "label": "Deep",
              "value": "deep"
            }
          ],
          "defaultValue": "balanced"
        }
      ],
      "defaultPresetId": "balanced-research",
      "presets": [
        {
          "id": "balanced-research",
          "label": "Balanced research",
          "answers": {
            "research_question": "Compare the current implementation against likely alternatives.",
            "depth": "balanced"
          }
        }
      ]
    },
    "result": {
      "title": "Research Result",
      "fields": [
        {
          "id": "export_format",
          "label": "Export format",
          "type": "select",
          "options": [
            {
              "label": "Markdown",
              "value": "markdown"
            },
            {
              "label": "JSON",
              "value": "json"
            }
          ],
          "defaultValue": "markdown"
        }
      ]
    }
  },
  "examples": [
    {
      "title": "Architecture comparison",
      "transcript": [
        {
          "role": "user",
          "content": "Compare three designs and summarize tradeoffs."
        }
      ]
    }
  ],
  "compat": {
    "claudeCode": {
      "minVersion": "1.0.0"
    }
  }
}
